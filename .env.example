# Copia este archivo a .env y completa tu clave. Nunca subas .env al repositorio.

# --- Claves de API -----------------------------------------------------------
# OpenAI es obligatoria: se usa para los embeddings (Anthropic no ofrece embeddings).
OPENAI_API_KEY=
# Solo si usas LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# --- LLM de chat -------------------------------------------------------------
# openai | anthropic
LLM_PROVIDER=openai
# Vacío = modelo por defecto del proveedor (openai: gpt-4o-mini, anthropic: claude-haiku-5-5)
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# --- Embeddings --------------------------------------------------------------
# Debe ser el MISMO para indexar y consultar; el sistema lo verifica.
EMBEDDINGS_PROVIDER=openai
# Vacío = text-embedding-3-small
EMBEDDINGS_MODEL=

# --- RAG ---------------------------------------------------------------------
RAG_DATA_DIR=data
RAG_PERSIST_DIR=vectorstore
RAG_COLLECTION=nimbus_docs
# Tokens por fragmento (mínimo 500) y solapamiento (mínimo 50)
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
# Fragmentos que recibe el LLM (entre 3 y 5)
RAG_TOP_K=4
